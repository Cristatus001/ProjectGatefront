* text=auto

# Unity YAML and source files remain normal text for reviewable diffs.
*.cs text diff=csharp
*.asmdef text
*.asmref text
*.shader text
*.cginc text
*.hlsl text
*.compute text
*.uxml text
*.uss text
*.json text
*.md text
*.txt text
*.unity text
*.prefab text
*.mat text
*.asset text
*.controller text
*.anim text
*.meta text

# Unity writes explicit empty YAML scalars with a trailing space.
*.asset whitespace=-trailing-space
*.meta whitespace=-trailing-space
*.unity whitespace=-trailing-space
*.wlt whitespace=-trailing-space
Assets/TutorialInfo/** whitespace=-trailing-space

# Large binary source and media assets use Git LFS.
*.psd filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
